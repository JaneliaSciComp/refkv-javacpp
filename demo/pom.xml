<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.refkv</groupId>
  <artifactId>refkv-bdv-demo</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>refkv BigDataViewer demo</name>
  <description>Opens a vzip archive of a foreign image file in BigDataViewer</description>

  <licenses>
    <license>
      <name>BSD-3-Clause</name>
      <url>https://opensource.org/license/bsd-3-clause</url>
      <distribution>repo</distribution>
    </license>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <n5-zarr.version>2.0.2-rectilinear.1</n5-zarr.version>
    <ffmpeg.version>8.1.2-1.5.14</ffmpeg.version>
  </properties>

  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>

  <!-- bigdataviewer-core 10.6.13 is built against imglib2 8.1.0, and the bindings against n5 4.0.2: say so,
       rather than let Maven pick the nearest of each -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>net.imglib2</groupId>
        <artifactId>imglib2</artifactId>
        <version>8.1.0</version>
      </dependency>
      <dependency>
        <groupId>org.janelia.saalfeldlab</groupId>
        <artifactId>n5</artifactId>
        <version>4.0.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.refkv</groupId>
      <artifactId>refkv-javacpp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.janelia.saalfeldlab</groupId>
      <artifactId>n5-zarr</artifactId>
      <!-- 2.0.2 is the release. Videos are on rectilinear chunk grids, which the fork has: it is installed from
           the rectilinear-chunk-grid branch as 2.0.2-rectilinear.1 (see README) -->
      <version>${n5-zarr.version}</version>
    </dependency>
    <!-- the refkv.stream codec, which decodes the pictures of a video with FFmpeg: JaneliaSciComp/n5-refkv-stream -->
    <dependency>
      <groupId>org.refkv</groupId>
      <artifactId>n5-refkv-stream</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>${ffmpeg.version}</version>
      <classifier>${ffmpeg.native}</classifier>
    </dependency>
    <!-- n5-blosc's jblosc brings JNA 4.2.2, whose macOS native stub is x86 only and cannot start on Apple Silicon -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.17.0</version>
    </dependency>
    <dependency>
      <groupId>org.janelia.saalfeldlab</groupId>
      <artifactId>n5-imglib2</artifactId>
      <version>8.0.1</version>
    </dependency>
    <dependency>
      <groupId>sc.fiji</groupId>
      <artifactId>bigdataviewer-core</artifactId>
      <version>10.6.13</version>
    </dependency>
    <dependency>
      <groupId>sc.fiji</groupId>
      <artifactId>bigdataviewer-vistools</artifactId>
      <version>1.0.0-beta-36</version>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>ffmpeg-macosx-arm64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties><ffmpeg.native>macosx-arm64</ffmpeg.native></properties>
    </profile>
    <profile>
      <id>ffmpeg-macosx-x86_64</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties><ffmpeg.native>macosx-x86_64</ffmpeg.native></properties>
    </profile>
    <profile>
      <id>ffmpeg-windows-x86_64</id>
      <activation><os><family>windows</family></os></activation>
      <properties><ffmpeg.native>windows-x86_64</ffmpeg.native></properties>
    </profile>
    <profile>
      <id>ffmpeg-linux-x86_64</id>
      <activation><os><family>unix</family><name>Linux</name></os></activation>
      <properties><ffmpeg.native>linux-x86_64</ffmpeg.native></properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <!-- `mvn exec:exec` runs the demo on the module's classpath, whatever the system: see the demo task in pixi.toml -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
