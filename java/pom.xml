<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.refkv</groupId>
  <artifactId>refkv-javacpp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>refkv JavaCPP bindings</name>
  <description>JavaCPP bindings to refkv (zarrify, phkv) and an N5 KeyValueAccess over refkv stores</description>

  <licenses>
    <license>
      <name>BSD-3-Clause</name>
      <url>https://opensource.org/license/bsd-3-clause</url>
      <distribution>repo</distribution>
    </license>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javacpp.version>1.5.14</javacpp.version>
    <n5.version>4.0.2</n5.version>
    <!-- 2.0.2 is the release. Rectilinear chunk grids need the fork branch: mvn -Dn5-zarr.version=2.0.2-rectilinear.1 (see README) -->
    <n5-zarr.version>2.0.2</n5-zarr.version>
    <ffmpeg.version>8.1.2-1.5.14</ffmpeg.version>
    <!-- where `pixi run capi` puts the header and the shared library -->
    <refkv.capi.include>${project.basedir}/../capi/include</refkv.capi.include>
    <refkv.capi.lib>${project.basedir}/../capi/target/release</refkv.capi.lib>
  </properties>

  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>javacpp</artifactId>
      <version>${javacpp.version}</version>
    </dependency>
    <dependency>
      <groupId>org.janelia.saalfeldlab</groupId>
      <artifactId>n5</artifactId>
      <version>${n5.version}</version>
    </dependency>
    <dependency>
      <groupId>org.janelia.saalfeldlab</groupId>
      <artifactId>n5-zarr</artifactId>
      <version>${n5-zarr.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- the refkv.stream codec decodes H.264 and other coded streams with FFmpeg. It is optional: classes that use it load only
         when a chunk of such a stream is read. The natives are for this build's own tests; an application brings its platform's -->
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>${ffmpeg.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.bytedeco</groupId>
      <artifactId>ffmpeg</artifactId>
      <version>${ffmpeg.version}</version>
      <classifier>${ffmpeg.native}</classifier>
      <scope>test</scope>
    </dependency>
    <!-- n5-blosc's jblosc brings JNA 4.2.2, whose macOS native stub is x86 only and cannot start on Apple Silicon -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.17.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- the FFmpeg natives of the platform the tests run on -->
    <profile>
      <id>ffmpeg-macosx-arm64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties><ffmpeg.native>macosx-arm64</ffmpeg.native></properties>
    </profile>
    <profile>
      <id>ffmpeg-macosx-x86_64</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties><ffmpeg.native>macosx-x86_64</ffmpeg.native></properties>
    </profile>
    <profile>
      <id>ffmpeg-windows-x86_64</id>
      <activation><os><family>windows</family></os></activation>
      <properties><ffmpeg.native>windows-x86_64</ffmpeg.native></properties>
    </profile>
    <profile>
      <id>ffmpeg-linux-x86_64</id>
      <activation><os><family>unix</family><name>Linux</name></os></activation>
      <properties><ffmpeg.native>linux-x86_64</ffmpeg.native></properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <!-- Builds the JNI library (libjnirefkv) from the generated org.refkv.javacpp.global.refkv.
           That class is generated, and committed, by `pixi run java-gen`, which parses capi/include/refkv.h. -->
      <plugin>
        <groupId>org.bytedeco</groupId>
        <artifactId>javacpp</artifactId>
        <version>${javacpp.version}</version>
        <configuration>
          <classPath>${project.build.outputDirectory}</classPath>
          <classOrPackageName>org.refkv.javacpp.global.refkv</classOrPackageName>
          <includePaths>
            <includePath>${refkv.capi.include}</includePath>
          </includePaths>
          <linkPaths>
            <linkPath>${refkv.capi.lib}</linkPath>
          </linkPaths>
          <copyLibs>true</copyLibs>
        </configuration>
        <executions>
          <execution>
            <id>javacpp-build</id>
            <phase>process-classes</phase>
            <goals><goal>build</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>-Djava.library.path=${refkv.capi.lib} --enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
